 @Override
 @Transactional
 public BreakSessionResponse forceEndBreak(Long sessionId, String adminNote) {
     BreakSession session = breakRepository.findById(sessionId)
             .orElseThrow(() -> new ResourceNotFoundException(
                 "Break", "id", sessionId));

     LocalDateTime endTime = LocalDateTime.now();
     long duration = Duration.between(session.getStartTime(), endTime).toMinutes();

     session.setEndTime(endTime);
     session.setDurationMinutes((int) duration);
     session.setStatus(BreakSession.Status.FORCE_STOPPED);
     session.setIsExceeded(true);
     session.setReason(session.getReason() + " | Admin: " + adminNote);

     return mapBreakToResponse(breakRepository.save(session));
 }

 // ============ DASHBOARD ============
 @Override
 public DailyWorkDashboard getMyDashboard(Long employeeId) {
     LocalDate today = LocalDate.now();
     LocalDateTime startOfDay = today.atStartOfDay();
     LocalDateTime endOfDay = today.plusDays(1).atStartOfDay();

     List<DailyWorkAssignment> allTasks = assignmentRepository
             .findByEmployeeIdAndAssignmentDateOrderByPriorityDesc(
                 employeeId, today);

     // Upcoming (next 7 days)
     List<DailyWorkAssignment> upcoming = assignmentRepository
             .findByEmployeeIdAndAssignmentDateBetweenOrderByAssignmentDateDesc(
                 employeeId, today.plusDays(1), today.plusDays(7));

     // Status distribution
     Map<String, Long> statusDist = allTasks.stream()
             .collect(Collectors.groupingBy(
                 a -> a.getStatus().name(), Collectors.counting()));

     // Category distribution
     Map<String, Long> catDist = allTasks.stream()
             .collect(Collectors.groupingBy(
                 a -> a.getCategory().name(), Collectors.counting()));

     // Priority distribution
     Map<String, Long> priorityDist = allTasks.stream()
             .collect(Collectors.groupingBy(
                 a -> a.getPriority().name(), Collectors.counting()));

     // Break time today
     Integer breakMinutes = breakRepository
             .sumBreakMinutesByEmployeeAndDateRange(
                 employeeId, startOfDay, endOfDay);
     if (breakMinutes == null) breakMinutes = 0;

     // Current active break
     BreakSession currentBreak = breakRepository
             .findByEmployeeIdAndStatus(employeeId, BreakSession.Status.ACTIVE)
             .orElse(null);

     long activeBreakMinutes = currentBreak != null
         ? currentBreak.getCurrentDurationMinutes() : 0;

     // Work minutes = 8*60 - break minutes (simplified)
     long workMinutes = Math.max(0, 480 - breakMinutes - activeBreakMinutes);

     // Productivity score
     double productivity = calculateProductivity(allTasks, workMinutes);

     int completed = (int) statusDist.getOrDefault("COMPLETED", 0L).longValue();
     int inProgress = (int) statusDist.getOrDefault("IN_PROGRESS", 0L).longValue();
     int pending = (int) statusDist.getOrDefault("ASSIGNED", 0L).longValue();
     int blocked = (int) statusDist.getOrDefault("BLOCKED", 0L).longValue();

     int overdue = (int) allTasks.stream().filter(DailyWorkAssignment::isOverdue).count();

     return DailyWorkDashboard.builder()
             .totalTasks(allTasks.size())
             .completed(completed)
             .inProgress(inProgress)
             .pending(pending)
             .blocked(blocked)
             .overdue(overdue)
             .totalWorkMinutes(workMinutes)
             .totalBreakMinutes(breakMinutes.longValue())
             .activeBreakMinutes(activeBreakMinutes)
             .currentBreak(currentBreak != null
                 ? mapBreakToResponse(currentBreak) : null)
             .todayTasks(allTasks.stream()
                 .map(this::mapToResponse)
                 .collect(Collectors.toList()))
             .upcomingTasks(upcoming.stream()
                 .limit(5).map(this::mapToResponse)
                 .collect(Collectors.toList()))
             .statusDistribution(statusDist)
             .categoryDistribution(catDist)
             .priorityDistribution(priorityDist)
             .productivityScore(productivity)
             .build();
 }

 @Override
 public Map<String, Object> getTeamDashboard() {
     Map<String, Object> data = new HashMap<>();
     LocalDate today = LocalDate.now();

     List<DailyWorkAssignment> todayAssignments = assignmentRepository
             .findAllByDate(today);

     List<BreakSession> activeBreaks = breakRepository.findAllActive();

     data.put("totalAssignmentsToday", todayAssignments.size());
     data.put("completedToday", todayAssignments.stream()
             .filter(a -> a.getStatus() == DailyWorkAssignment.Status.COMPLETED)
             .count());
     data.put("inProgress", todayAssignments.stream()
             .filter(a -> a.getStatus() == DailyWorkAssignment.Status.IN_PROGRESS)
             .count());
     data.put("blocked", todayAssignments.stream()
             .filter(a -> a.getStatus() == DailyWorkAssignment.Status.BLOCKED)
             .count());
     data.put("overdue", assignmentRepository.findOverdue(today).size());
     data.put("employeesOnBreak", activeBreaks.size());
     data.put("activeBreaks", activeBreaks.stream()
             .map(this::mapBreakToResponse)
             .collect(Collectors.toList()));

     // Employees exceeding break time
     List<Map<String, Object>> exceededBreaks = activeBreaks.stream()
             .filter(b -> b.getMaxAllowedMinutes() != null &&
                 b.getCurrentDurationMinutes() > b.getMaxAllowedMinutes())
             .map(b -> {
                 Map<String, Object> m = new HashMap<>();
                 m.put("employeeName", b.getEmployee().getFullName());
                 m.put("breakType", b.getBreakType().name());
                 m.put("currentMinutes", b.getCurrentDurationMinutes());
                 m.put("maxAllowed", b.getMaxAllowedMinutes());
                 m.put("excessMinutes",
                     b.getCurrentDurationMinutes() - b.getMaxAllowedMinutes());
                 return m;
             })
             .collect(Collectors.toList());
     data.put("exceededBreaks", exceededBreaks);

     return data;
 }

 @Override
 public Map<String, Object> getEmployeeStats(
         Long employeeId, LocalDate start, LocalDate end) {
     Map<String, Object> stats = new HashMap<>();

     List<DailyWorkAssignment> assignments = assignmentRepository
             .findByEmployeeIdAndAssignmentDateBetweenOrderByAssignmentDateDesc(
                 employeeId, start, end);

     long completed = assignments.stream()
             .filter(a -> a.getStatus() == DailyWorkAssignment.Status.COMPLETED)
             .count();

     double avgProgress = assignments.stream()
             .filter(a -> a.getProgressPercentage() != null)
             .mapToInt(DailyWorkAssignment::getProgressPercentage)
             .average().orElse(0);

     Integer totalBreakMinutes = breakRepository
             .sumBreakMinutesByEmployeeAndDateRange(
                 employeeId, start.atStartOfDay(), end.plusDays(1).atStartOfDay());

     stats.put("totalAssignments", assignments.size());
     stats.put("completedAssignments", completed);
     stats.put("completionRate", assignments.isEmpty() ? 0
         : Math.round((completed * 100.0) / assignments.size() * 100.0) / 100.0);
     stats.put("averageProgress", Math.round(avgProgress * 100.0) / 100.0);
     stats.put("totalBreakMinutes",
         totalBreakMinutes != null ? totalBreakMinutes : 0);

     return stats;
 }

 // ============ HELPERS ============
 private DailyWorkAssignment getAssignmentEntity(Long id) {
     return assignmentRepository.findById(id)
             .orElseThrow(() -> new ResourceNotFoundException(
                 "Assignment", "id", id));
 }

 private String generateAssignmentNumber() {
     long count = assignmentRepository.count() + 1;
     return String.format("TSK-%d-%06d",
         LocalDate.now().getYear(), count);
 }

 private double calculateProductivity(List<DailyWorkAssignment> tasks,
                                        long workMinutes) {
     if (tasks.isEmpty()) return 0;

     double completionRate = tasks.stream()
             .filter(t -> t.getStatus() == DailyWorkAssignment.Status.COMPLETED)
             .count() * 100.0 / tasks.size();

     double avgProgress = tasks.stream()
             .filter(t -> t.getProgressPercentage() != null)
             .mapToInt(DailyWorkAssignment::getProgressPercentage)
             .average().orElse(0);

     double workUtilization = Math.min(100, (workMinutes * 100.0) / 480);

     return Math.round((completionRate * 0.4 + avgProgress * 0.3
         + workUtilization * 0.3) * 100.0) / 100.0;
 }

 private AssignmentResponse mapToResponse(DailyWorkAssignment a) {
     String assignedByName = "Unknown";
     try {
         User user = userRepository.findById(a.getAssignedBy()).orElse(null);
         if (user != null) {
             Employee emp = employeeRepository.findByUser_Id(user.getId())
                 .orElse(null);
             assignedByName = emp != null ? emp.getFullName() : user.getUsername();
         }
     } catch (Exception ignored) {}

     String projectName = null;
     if (a.getProjectId() != null) {
         projectName = projectRepository.findById(a.getProjectId())
                 .map(Project::getName).orElse(null);
     }

     Long commentCount = (long) commentRepository
             .findByAssignmentIdOrderByCreatedAtDesc(a.getId()).size();

     return AssignmentResponse.builder()
             .id(a.getId())
             .assignmentNumber(a.getAssignmentNumber())
             .employeeId(a.getEmployee().getId())
             .employeeName(a.getEmployee().getFullName())
             .employeeCode(a.getEmployee().getEmployeeId())
             .assignedBy(a.getAssignedBy())
             .assignedByName(assignedByName)
             .title(a.getTitle())
             .description(a.getDescription())
             .category(a.getCategory().name())
             .priority(a.getPriority().name())
             .status(a.getStatus().name())
             .assignmentDate(a.getAssignmentDate())
             .dueDate(a.getDueDate())
             .dueTime(a.getDueTime())
             .estimatedHours(a.getEstimatedHours())
             .actualHours(a.getActualHours())
             .remainingHours(a.getRemainingHours())
             .progressPercentage(a.getProgressPercentage())
             .projectId(a.getProjectId())
             .projectName(projectName)
             .tags(a.getTags())
             .attachments(a.getAttachments())
             .blockerReason(a.getBlockerReason())
             .completionNotes(a.getCompletionNotes())
             .startedAt(a.getStartedAt())
             .completedAt(a.getCompletedAt())
             .isOverdue(a.isOverdue())
             .isRecurring(a.getIsRecurring())
             .totalComments(commentCount)
             .createdAt(a.getCreatedAt())
             .updatedAt(a.getUpdatedAt())
             .build();
 }

 private BreakSessionResponse mapBreakToResponse(BreakSession b) {
     return BreakSessionResponse.builder()
             .id(b.getId())
             .employeeId(b.getEmployee().getId())
             .employeeName(b.getEmployee().getFullName())
             .breakType(b.getBreakType().name())
             .startTime(b.getStartTime())
             .endTime(b.getEndTime())
             .durationMinutes(b.getDurationMinutes())
             .currentDurationMinutes(b.getCurrentDurationMinutes())
             .maxAllowedMinutes(b.getMaxAllowedMinutes())
             .isExceeded(b.getIsExceeded())
             .reason(b.getReason())
             .location(b.getLocation())
             .status(b.getStatus().name())
             .createdAt(b.getCreatedAt())
             .build();
 }
