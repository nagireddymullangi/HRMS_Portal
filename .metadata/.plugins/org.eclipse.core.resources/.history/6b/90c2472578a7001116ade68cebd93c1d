 // ============ BREAK MANAGEMENT ============
 @Override
 @Transactional
 public BreakSessionResponse startBreak(Long employeeId, String breakType,
                                         String reason, String location) {
     // Check if already on break
     Optional<BreakSession> active = breakRepository
             .findByEmployeeIdAndStatus(employeeId, BreakSession.Status.ACTIVE);

     if (active.isPresent()) {
         throw new HrmsAPIException(HttpStatus.BAD_REQUEST,
             "You are already on a break. End current break first.");
     }

     Employee employee = employeeRepository.findById(employeeId)
             .orElseThrow(() -> new ResourceNotFoundException(
                 "Employee", "id", employeeId));

     BreakSession.BreakType type = breakType != null
         ? BreakSession.BreakType.valueOf(breakType)
         : BreakSession.BreakType.SHORT_BREAK;

     BreakSession session = BreakSession.builder()
             .employee(employee)
             .breakType(type)
             .startTime(LocalDateTime.now())
             .maxAllowedMinutes(type.getDefaultMaxMinutes())
             .reason(reason)
             .location(location)
             .status(BreakSession.Status.ACTIVE)
             .build();

     return mapBreakToResponse(breakRepository.save(session));
 }

 @Override
 @Transactional
 public BreakSessionResponse endBreak(Long sessionId) {
     BreakSession session = breakRepository.findById(sessionId)
             .orElseThrow(() -> new ResourceNotFoundException(
                 "Break Session", "id", sessionId));

     if (session.getStatus() != BreakSession.Status.ACTIVE) {
         throw new HrmsAPIException(HttpStatus.BAD_REQUEST,
             "Break session is not active");
     }

     LocalDateTime endTime = LocalDateTime.now();
     long duration = Duration.between(session.getStartTime(), endTime).toMinutes();

     session.setEndTime(endTime);
     session.setDurationMinutes((int) duration);
     session.setStatus(BreakSession.Status.COMPLETED);

     // Check if exceeded
     if (session.getMaxAllowedMinutes() != null &&
         duration > session.getMaxAllowedMinutes()) {
         session.setIsExceeded(true);
     }

     return mapBreakToResponse(breakRepository.save(session));
 }

