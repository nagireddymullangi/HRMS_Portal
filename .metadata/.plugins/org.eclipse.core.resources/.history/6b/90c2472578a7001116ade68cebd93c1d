 // ============ ASSIGNMENTS ============
 @Override
 @Transactional
 public AssignmentResponse createAssignment(
         DailyWorkAssignment assignment, Long assignedBy) {

     assignment.setAssignmentNumber(generateAssignmentNumber());
     assignment.setAssignedBy(assignedBy);
     assignment.setStatus(DailyWorkAssignment.Status.ASSIGNED);

     if (assignment.getAssignmentDate() == null) {
         assignment.setAssignmentDate(LocalDate.now());
     }

     DailyWorkAssignment saved = assignmentRepository.save(assignment);
     log.info("Assignment created: {} for employee: {}",
         saved.getAssignmentNumber(), saved.getEmployee().getId());

     return mapToResponse(saved);
 }

 @Override
 @Transactional
 public List<AssignmentResponse> createBulkAssignments(
         List<DailyWorkAssignment> assignments, Long assignedBy) {
     return assignments.stream()
         .map(a -> createAssignment(a, assignedBy))
         .collect(Collectors.toList());
 }

 @Override
 @Transactional
 public AssignmentResponse updateAssignment(
         Long id, DailyWorkAssignment assignment) {
     DailyWorkAssignment existing = assignmentRepository.findById(id)
             .orElseThrow(() -> new ResourceNotFoundException(
                 "Assignment", "id", id));

     if (existing.getStatus() == DailyWorkAssignment.Status.COMPLETED) {
         throw new HrmsAPIException(HttpStatus.BAD_REQUEST,
             "Cannot edit completed assignment");
     }

     if (assignment.getTitle() != null)
         existing.setTitle(assignment.getTitle());
     if (assignment.getDescription() != null)
         existing.setDescription(assignment.getDescription());
     if (assignment.getCategory() != null)
         existing.setCategory(assignment.getCategory());
     if (assignment.getPriority() != null)
         existing.setPriority(assignment.getPriority());
     if (assignment.getDueDate() != null)
         existing.setDueDate(assignment.getDueDate());
     if (assignment.getDueTime() != null)
         existing.setDueTime(assignment.getDueTime());
     if (assignment.getEstimatedHours() != null)
         existing.setEstimatedHours(assignment.getEstimatedHours());
     if (assignment.getTags() != null)
         existing.setTags(assignment.getTags());
     if (assignment.getProjectId() != null)
         existing.setProjectId(assignment.getProjectId());

     return mapToResponse(assignmentRepository.save(existing));
 }

