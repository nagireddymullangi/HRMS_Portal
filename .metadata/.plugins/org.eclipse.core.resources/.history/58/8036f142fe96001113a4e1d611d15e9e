 private String wrapInHtmlTemplate(String content, String title) {
     return """
         <!DOCTYPE html>
         <html>
         <head>
             <meta charset="UTF-8"/>
             <title>%s</title>
             <style>
                 body { font-family: Arial, sans-serif; line-height: 1.6; }
                 h1, h2, h3 { color: #1e40af; }
                 table { width: 100%%; border-collapse: collapse; }
             </style>
         </head>
         <body>
             %s
         </body>
         </html>
         """.formatted(title, content);
 }



